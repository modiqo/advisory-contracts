{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.modiqo.com/advisory/v1/advisory-rubric.schema.json",
  "title": "Advisory Rubric",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rubric_id", "title", "source", "applicability", "criteria", "disqualifiers", "required_questions", "attribution_links"],
  "properties": {
    "schema_version": { "const": "v1" },
    "rubric_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "skill_id", "loaded_at"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "collection": { "type": "string" },
        "skill_id": { "type": "string", "minLength": 1 },
        "server_version": { "type": "string" },
        "loaded_at": { "type": "string", "format": "date-time" }
      }
    },
    "applicability": { "type": "string", "minLength": 1 },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "question"],
        "properties": {
          "criterion_id": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "minimum": 0 },
          "evidence_requirements": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "disqualifiers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "required_questions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "attribution_links": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "extensions": { "type": "object", "additionalProperties": true }
  }
}
