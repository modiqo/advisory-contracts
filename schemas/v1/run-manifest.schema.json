{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.modiqo.com/advisory/v1/run-manifest.schema.json",
  "title": "Advisory Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "contract", "started_at", "modules", "adapters", "degraded_stages", "blocked_sources"],
  "properties": {
    "schema_version": { "const": "v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "play_uri": { "type": "string" },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "content_hash"],
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "modules": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fingerprint"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "fingerprint": { "type": "string", "minLength": 1 }
        }
      }
    },
    "degraded_stages": { "type": "array", "items": { "type": "string" } },
    "blocked_sources": { "type": "array", "items": { "type": "string" } },
    "extensions": { "type": "object", "additionalProperties": true }
  }
}
