{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.modiqo.com/advisory/v1/evidence-item.schema.json",
  "title": "Evidence Item",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "source", "source_family", "subject", "claim", "stance", "observed_at", "confidence", "sensitivity", "raw_reference"],
  "properties": {
    "evidence_id": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "source_family": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "claim": { "type": "string", "minLength": 1 },
    "stance": { "enum": ["supports", "opposes", "neutral", "unknown"] },
    "observed_at": { "type": "string", "format": "date-time" },
    "fresh_until": { "type": "string", "format": "date-time" },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "reason"],
      "properties": {
        "level": { "enum": ["low", "medium", "high"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "sensitivity": { "enum": ["public", "internal", "confidential", "restricted"] },
    "raw_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "enum": ["url", "adapter-response", "file", "message", "record", "manual"] },
        "value": { "type": "string", "minLength": 1 },
        "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "extensions": { "type": "object", "additionalProperties": true }
  }
}
