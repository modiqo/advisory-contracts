{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.modiqo.com/advisory/v1/module-manifest.schema.json",
  "title": "Advisory Module Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "module_id", "kind", "consumes", "produces", "effects", "requires", "contract_versions"],
  "properties": {
    "schema_version": { "const": "v1" },
    "module_id": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["collector", "normalizer", "advisor", "challenger", "renderer", "writer"] },
    "consumes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "produces": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "effects": { "enum": ["none", "read", "write"] },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapters", "plays", "host_tools"],
      "properties": {
        "adapters": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "plays": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "host_tools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "sensitivities": { "type": "array", "items": { "enum": ["public", "internal", "confidential", "restricted"] }, "uniqueItems": true },
    "contract_versions": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^v[0-9]+$" }, "uniqueItems": true },
    "extensions": { "type": "object", "additionalProperties": true }
  }
}
