{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.modiqo.com/advisory/v1/operating-brief.schema.json",
  "title": "Operating Brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "brief_id", "actor", "generated_at", "window", "headline", "evidence_bundle_id", "priorities", "watchlist", "source_coverage", "unknowns"],
  "properties": {
    "schema_version": { "const": "v1" },
    "brief_id": { "type": "string", "minLength": 1 },
    "actor": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "headline": { "type": "string", "minLength": 1, "maxLength": 240 },
    "evidence_bundle_id": { "type": "string", "minLength": 1 },
    "priorities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority_id", "rank", "title", "recommendation", "why_now", "evidence_for", "evidence_against", "confidence", "success_signal", "next_action"],
        "properties": {
          "priority_id": { "type": "string", "minLength": 1 },
          "rank": { "type": "integer", "minimum": 1, "maximum": 3 },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "recommendation": { "type": "string", "minLength": 1, "maxLength": 600 },
          "why_now": { "type": "string", "minLength": 1, "maxLength": 600 },
          "evidence_for": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "evidence_against": { "type": "array", "maxItems": 2, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "confidence": { "enum": ["low", "medium", "high"] },
          "success_signal": { "type": "string", "minLength": 1, "maxLength": 300 },
          "decision_deadline": { "type": "string", "format": "date-time" },
          "next_action": { "$ref": "https://schemas.modiqo.com/advisory/v1/action-intent.schema.json" }
        }
      }
    },
    "watchlist": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signal", "why_it_matters", "evidence_refs"],
        "properties": {
          "signal": { "type": "string", "minLength": 1, "maxLength": 240 },
          "why_it_matters": { "type": "string", "minLength": 1, "maxLength": 300 },
          "evidence_refs": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    },
    "source_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "status", "detail"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "status": { "enum": ["fresh", "degraded", "missing"] },
          "detail": { "type": "string", "minLength": 1, "maxLength": 300 },
          "last_observed_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "unknowns": { "type": "array", "maxItems": 5, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "extensions": { "type": "object", "additionalProperties": true }
  }
}
